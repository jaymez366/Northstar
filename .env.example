VITE_SUPABASE_URL=https://YOUR_NORTHSTAR_PROJECT_REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_NORTHSTAR_PUBLIC_PUBLISHABLE_KEY
# Alternatively, use VITE_SUPABASE_ANON_KEY instead of VITE_SUPABASE_PUBLISHABLE_KEY.

# Optional WebRTC ICE configuration. STUN helps discover network routes but does
# not relay media. Calls across restrictive/NAT networks require a TURN service.
VITE_NORTHSTAR_STUN_URLS=stun:stun.example.net:3478
VITE_NORTHSTAR_TURN_URLS=turn:turn.example.net:3478?transport=udp,turns:turn.example.net:5349?transport=tcp
# HTTPS endpoint that authenticates the NorthStar user and returns short-lived
# { username, credential, expires_at } TURN credentials. Never put credentials here.
VITE_NORTHSTAR_TURN_CREDENTIALS_URL=https://your-domain.example/api/turn-credentials
