VITE_SUPABASE_URL=https://YOUR_NORTHSTAR_PROJECT_REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_NORTHSTAR_PUBLIC_PUBLISHABLE_KEY
# Alternatively, use VITE_SUPABASE_ANON_KEY instead of VITE_SUPABASE_PUBLISHABLE_KEY.

# The API origin is optional when the frontend and API share an origin; local Vite
# development proxies /api to FastAPI on port 8000.
VITE_NORTHSTAR_API_BASE_URL=
# Optional additional STUN URIs. Temporary TURN credentials and TURN URLs come
# from the authenticated FastAPI endpoint, never from Vite configuration.
VITE_NORTHSTAR_STUN_URLS=stun:stun.example.net:3478
