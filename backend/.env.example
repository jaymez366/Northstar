# Copy to .env locally. Values below are placeholders, not credentials.
APP_NAME=NorthStar API
ENVIRONMENT=development
LOG_LEVEL=INFO
API_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:3000
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=YOUR_PUBLIC_SUPABASE_ANON_OR_PUBLISHABLE_KEY
JWT_ISSUER=https://YOUR_PROJECT_REF.supabase.co/auth/v1
JWT_AUDIENCE=authenticated
JWT_JWKS_URL=https://YOUR_PROJECT_REF.supabase.co/auth/v1/.well-known/jwks.json
JWT_ALGORITHMS=ES256,RS256
MAX_REQUEST_BODY_BYTES=1048576
# Configure these only in backend/.env or a server-side secret store.
TWILIO_ACCOUNT_SID=YOUR_TWILIO_ACCOUNT_SID
TWILIO_API_KEY=YOUR_TWILIO_API_KEY
TWILIO_API_SECRET=YOUR_TWILIO_API_SECRET
TWILIO_TURN_TTL_SECONDS=3600
# Shared Render Key Value URL; configure only in the backend environment.
# Required for production. Use the private connection URL from Render.
RATE_LIMIT_REDIS_URL=redis://YOUR_RENDER_KEY_VALUE_HOST:6379
ICE_SERVERS_USER_LIMIT=10
ICE_SERVERS_GLOBAL_LIMIT=120
ICE_SERVERS_RATE_WINDOW_SECONDS=60
